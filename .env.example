# Optional. When set, field classification and the assistant use Claude.
# Without it the app still works with the local heuristics and the rule-based assistant.
ANTHROPIC_API_KEY=

# Optional. Added automatically by Vercel when a Blob store is connected to the project.
# Enables "Synchronisation cloud" (documents, modèles, contacts partagés entre ordinateurs).
BLOB_READ_WRITE_TOKEN=

# ---- Amaz (générateur de factures), copié tel quel : mêmes variables que son projet d'origine ----
# Boutons IA d'Amaz (OpenAI). Optionnel : OPENAI_MODEL (défaut gpt-5.4-mini).
OPENAI_API_KEY=
# Synchronisation Amaz : base Upstash Redis (Vercel → Storage → Upstash) + code d'accès.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CODE_ACCES=
