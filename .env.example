# Optional. When set, field classification and the assistant use Claude.
# Without it the app still works with the local heuristics and the rule-based assistant.
ANTHROPIC_API_KEY=

# Optional. Added automatically by Vercel when a Blob store is connected to the project.
# Enables "Synchronisation cloud" (documents, modèles, contacts partagés entre ordinateurs).
BLOB_READ_WRITE_TOKEN=
